{
  "name": "gestion-stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n API,WEB -c cyan,green \"npm:dev:server\" \"npm:dev\"",
    "dev:server": "npm run db:start && node --watch server/index.js",
    "server": "node server/index.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File server/scripts/postgres-local.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File server/scripts/postgres-local.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File server/scripts/postgres-local.ps1 status",
    "db:migrate": "node server/db/migrar.js",
    "db:check": "node server/db/estado.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
