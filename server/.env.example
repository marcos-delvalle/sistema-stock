# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL. Usar un usuario dedicado (no el superusuario postgres).
# Formato: postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BASE
DATABASE_URL=postgresql://stock_app:CAMBIAR_PASSWORD@localhost:5432/gestion_stock

# Login único de administrador (todos los compañeros usan esta cuenta)
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE

# Secreto para firmar la cookie de sesión.
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTE_SECRETO
